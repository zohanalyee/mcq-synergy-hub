# Cache headers for static assets (Netlify-style; honored by some static hosts).
# Vite emits content-hashed filenames in /assets/*, so a 1-year immutable
# Cache-Control is safe — every change produces a new hashed file name.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/sitemaps/*
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
